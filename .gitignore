# ─── rebuilt by setup_scripts/install_figs.sh ──────────────────────────────────
# Nothing in here is authored by us; all of it is reproducible from the scripts
# and pinned versions that ARE committed.

# Miniconda plus the 'kitchen' env. Several GB, and conda is not relocatable —
# a copied env is broken anyway, so committing one would be worse than useless.
figs/miniconda3/

# Upstream's repo (StanfordMSL/SousVide), cloned by install step `clone`.
# Committing it would embed a foreign checkout; our additions to it live in
# figs/sousvide_overlay/ and are restored by setup_scripts/apply_overlay.sh.
figs/SousVide/

# Generated by install step `envfile` with absolute paths baked in — machine
# specific by construction.
figs/figs_env.sh

# Pipeline resume markers and per-stage logs.
figs/.figs_pipeline_state/
figs/.figs_pipeline_logs/
figs/.figs_install_state/
figs/.figs_install_logs/
setup_scripts/install.log

# ─── too large for git ─────────────────────────────────────────────────────────
# Raw phone footage: ~3 GB per capture. Keep the masters off-repo.
video_captures/

# Splat training artefacts: ~8 GB per scene, with a 371-751 MB checkpoint.
# GitHub rejects any single file over 100 MB.
**/gsplats/
**/*.ckpt
**/*.h5
**/*.ply

# Rendered flights are ~1 MB and ARE committed (outputs/flights/), but the
# intermediates are not.
*.partial

# ─── editor / OS noise ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# added by init_fyp_repo.sh on 2026-08-07
**/.cache/
*.pth

# added by init_fyp_repo.sh on 2026-08-07
figs/.tmp/
**/torchinductor_*/
*.log.INFO.*
*.cubin
*.ptx

# semantic embeddings (docs/SEMANTICS.md): step markers, editable-install metadata
figs/.semantic_pipeline_state/
semantics/*.egg-info/
